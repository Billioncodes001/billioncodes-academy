{
  "name": "billion-codes-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run test:learning && vite build && node scripts/build-offline.mjs",
    "test:learning": "node --test packages/learning/tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p src/tsconfig.json",
    "test:frontend": "playwright test --config tests/frontend/playwright.config.ts",
    "test:backend": "node --test worker/tests/backend.test.mjs",
    "test:assets:local": "node --test tests/frontend/assets.test.mjs",
    "preview:cloudflare": "wrangler dev --port 8788 --var ALLOWED_ORIGINS:http://localhost:5174,http://localhost:8788,http://127.0.0.1:5174,http://127.0.0.1:8788",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply billioncodes-academy-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply billioncodes-academy-db --remote"
  },
  "dependencies": {
    "@billioncodes/learning": "file:packages/learning",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/space-grotesk": "^5.2.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "4.131.1"
  }
}
